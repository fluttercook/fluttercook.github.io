---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

// The editor is one dependency-free fragment shared by this page, the Vietnamese
// page, and the Blogger mirror — edit tools/screenshot-studio/studio.html only.
const studio = fs.readFileSync(
  new URL('../../../tools/screenshot-studio/studio.html', import.meta.url),
  'utf8'
);

const site = 'https://fluttercook.github.io';
const url = `${site}/tools/screenshot-studio/`;
const title = 'App Store Screenshot Generator — free, in your browser | FlutterCook';
const description =
  'Free App Store and Google Play screenshot generator. Add your app screens, write captions, pick a template, and export store-ready PNGs at 1320×2868, 1080×1920 and more. No upload, no account, no watermark.';

const faqs = [
  {
    q: 'What screenshot sizes does the App Store actually require?',
    a: 'App Store Connect accepts a 6.9" iPhone set at 1320×2868 (or 1290×2796) and, if you ship for iPad, a 13" set at 2064×2752. Google Play wants 1080×1920 or larger, 16:9 or 9:16, under 8 MB per image. The studio exports all of those, plus any custom size you type in.',
  },
  {
    q: 'Are my app screenshots uploaded anywhere?',
    a: 'No. The images you drop in are read with the browser FileReader API and drawn straight onto a canvas. Nothing is sent to a server — you can disconnect from the network and the tool still works.',
  },
  {
    q: 'How many screenshots should I upload to the store?',
    a: 'You can upload up to 10 per device set on the App Store and 8 on Google Play, but the first two or three are what most people see in search results. Put your strongest benefit on screen one and treat the rest as supporting evidence.',
  },
  {
    q: 'Can I use the exported PNGs commercially?',
    a: 'Yes. The output is your own artwork — your app screens, your captions, plain shapes drawn by the browser. There is no watermark and no licence attached.',
  },
  {
    q: 'Why does my headline get smaller when I type more?',
    a: 'The headline auto-shrinks once it would wrap past three lines, because four-line captions stop being readable at store thumbnail size. If it is shrinking, that is a hint the caption is too long — aim for five to seven words.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'App Store Screenshot Studio',
    applicationCategory: 'DesignApplication',
    operatingSystem: 'Any modern browser',
    url,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'FlutterCook', url: site },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FlutterCook', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'App Store Screenshot Studio', item: url },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  keywords={[
    'app store screenshot generator',
    'google play screenshot maker',
    'app screenshot template',
    'iphone 6.9 screenshot size',
    'aso screenshots',
    'free screenshot mockup tool',
  ]}
  jsonLd={jsonLd}
>
  <main class="wrap">
    <section class="hero">
      <div class="kicker">Free browser tool · no account</div>
      <h1 class="serif">App Store screenshots, <i>without the design file</i>.</h1>
      <p>
        Pick a template, drop in your app screens, write the captions, and export PNGs at the exact
        sizes App Store Connect and Google Play Console ask for. Everything renders in your browser —
        your screens are never uploaded.
      </p>
    </section>

    <Fragment set:html={studio} />

    <section class="doc">
      <h2>How to use it</h2>
      <ol>
        <li><b>Pick a template.</b> Twenty-four templates set background, accent, typeface, device frame and caption position together. Filter by Light / Dark / Colourful, or type a category ("finance", "games", "books") into the search box. Alternating backgrounds (Violet, Mint) give you the strip look stores show off; gradients read better when every screen stands alone.</li>
        <li><b>Choose the export size first.</b> Layout is proportional, so switching from a 19.5:9 iPhone to a 4:3 iPad after you have tuned the caption band will move things around.</li>
        <li><b>Add your screens.</b> Click a card to select it, then <i>Upload screen…</i> — or drag a PNG straight onto the card. Images are cover-fitted into the device screen, never stretched.</li>
        <li><b>Write captions like ad copy.</b> One benefit per screen, five to seven words, no feature names nobody has heard of yet.</li>
        <li><b>Export.</b> The ⬇ under a card saves that one; <i>Download all PNG</i> walks the whole set with a short pause between files so the browser does not drop them.</li>
      </ol>

      <h2>Store sizes cheat sheet</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Store</th><th>Set</th><th>Pixels</th></tr></thead>
          <tbody>
            <tr><td>App Store</td><td>iPhone 6.9"</td><td>1320 × 2868</td></tr>
            <tr><td>App Store</td><td>iPhone 6.5"</td><td>1242 × 2688</td></tr>
            <tr><td>App Store</td><td>iPad 13"</td><td>2064 × 2752</td></tr>
            <tr><td>Google Play</td><td>Phone</td><td>1080 × 1920 (min)</td></tr>
            <tr><td>Google Play</td><td>Phone, 16:9 high-res</td><td>2160 × 3840</td></tr>
          </tbody>
        </table>
      </div>
      <p class="note">
        Apple scales one 6.9" set down to the smaller iPhone displays, so a single set is usually
        enough unless you want display-specific art. Google Play requires at least two screenshots
        before you can publish.
      </p>

      <h2>Questions</h2>
      {faqs.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>
  </main>

  <style>
    .doc { max-width: 780px; margin: 40px auto 0; }
    .doc h2 { font-size: 22px; margin: 34px 0 12px; }
    .doc ol { padding-left: 20px; display: grid; gap: 10px; color: var(--muted); }
    .doc ol b { color: var(--ink); }
    .tablewrap { overflow-x: auto; }
    .doc table { width: 100%; border-collapse: collapse; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--panel); font-size: 14px; }
    .doc th { text-align: left; background: #101012; color: var(--muted); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; padding: 11px 14px; }
    .doc td { padding: 11px 14px; border-top: 1px solid var(--line); }
    .doc .note { color: var(--muted); font-size: 13.5px; margin-top: 12px; }
    .doc details { border: 1px solid var(--line); border-radius: 10px; padding: 12px 14px; margin-bottom: 8px; background: var(--panel); }
    .doc summary { cursor: pointer; font-weight: 600; }
    .doc details p { color: var(--muted); margin: 10px 0 0; font-size: 14.5px; }
  </style>
</BaseLayout>
