---
import fs from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';

const gallery = fs.readFileSync(
  new URL('../../../tools/widget-preview/gallery.html', import.meta.url),
  'utf8'
);

const site = 'https://fluttercook.github.io';
const url = `${site}/tools/widget-preview/`;
const title = 'Flutter Widget Preview — live Material demos + copyable Dart | FlutterCook';
const description =
  'Browse Flutter Material widgets by group, interact with live previews, search, and copy production-ready Dart snippets. Buttons, inputs, navigation, surfaces, feedback — free in your browser.';

const faqs = [
  {
    q: 'Are these real Flutter widgets running in the browser?',
    a: 'The previews are faithful Material 3-style recreations with real interaction (switches, chips, tabs, selection). The Dart on the right is the production API you paste into a Flutter app. For a full engine preview, use the official Flutter Widget Previewer in your IDE — this page is the fast lookup and copy layer.',
  },
  {
    q: 'Can I use the Dart snippets commercially?',
    a: 'Yes. They are standard Flutter framework APIs (Material widgets). Copy them into any project without attribution.',
  },
  {
    q: 'How do I find a widget quickly?',
    a: 'Use the search box in the left rail. It matches widget name, group, description, and code. On mobile the catalog collapses above the preview.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'Flutter Widget Preview',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any modern browser',
    url,
    description,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    publisher: { '@type': 'Organization', name: 'FlutterCook', url: site },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FlutterCook', item: `${site}/` },
      { '@type': 'ListItem', position: 2, name: 'Widget Preview', item: url },
    ],
  },
];
---
<BaseLayout
  title={title}
  description={description}
  keywords={[
    'flutter widget preview',
    'material 3 widgets demo',
    'flutter elevated button example',
    'flutter widget catalog',
    'copy dart widget code',
    'flutter ui kit live preview',
  ]}
  ogType="website"
  jsonLd={jsonLd}
>
  <main class="wrap" style="padding:2vh 24px 6vh">
    <nav class="crumb" aria-label="Breadcrumb">
      <a href="/">FlutterCook</a> / Tools / Widget Preview
    </nav>
    <header style="margin:12px 0 18px;max-width:720px">
      <p class="wp-kicker" style="margin:0 0 6px">Free tool · No signup</p>
      <h1 style="font-size:clamp(28px,4vw,42px);font-weight:400;line-height:1.1;margin:0 0 10px">
        Flutter widget <i style="font-style:italic;color:var(--accent)">preview</i>
      </h1>
      <p style="color:var(--muted);margin:0;font-size:16px">
        Left rail lists Material widgets by group. The middle stage is a live preview you can click.
        Copy the Dart underneath into your app. Search matches name, group, and code.
      </p>
    </header>

    <Fragment set:html={gallery} />

    <section class="prose" style="margin-top:36px;max-width:760px">
      <h2>How to use this gallery</h2>
      <p>
        Pick a widget from the grouped list (Buttons, Inputs, Navigation, Surfaces, Layout, Feedback).
        Interact with the preview to feel the state change, then hit <strong>Copy code</strong> and paste
        the snippet into your Flutter project. Search is instant — try <code>chip</code>, <code>dialog</code>, or <code>AppBar</code>.
      </p>
      <h2>When to use the IDE previewer instead</h2>
      <p>
        For <code>@Preview</code> functions on your own widgets, use Flutter’s official Widget Previewer
        (stable in 3.47). This page is for browsing framework Material patterns without opening an IDE.
      </p>
      <h2>FAQ</h2>
      {faqs.map((f) => (
        <Fragment>
          <h3>{f.q}</h3>
          <p>{f.a}</p>
        </Fragment>
      ))}
    </section>
  </main>
</BaseLayout>
