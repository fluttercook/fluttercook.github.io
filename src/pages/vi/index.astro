---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CardRail from '../../components/CardRail.astro';
import { getCollection } from 'astro:content';
const all = (await getCollection('recipesVi')).filter((r) => !r.data.draft);
const featured = all.sort((a, b) => (a.data.trendRank || 9999) - (b.data.trendRank || 9999)).slice(0, 9);
const cats = [...new Set(all.map((r) => r.data.category))];
const total = all.length;

// Mới nhất trước, rồi cắt còn đủ cho một hàng. Rail dẫn sang trang danh sách
// đầy đủ thay vì dài thêm, nên trang chủ không phình ra theo số bài.
const byDate = (a, b) => (a.data.publishDate < b.data.publishDate ? 1 : -1);
const latestPosts = (await getCollection('blogVi')).filter((p) => !p.data.draft).sort(byDate).slice(0, 6);
const latestNews = (await getCollection('newsVi')).filter((n) => !n.data.draft).sort(byDate).slice(0, 6);
const fmtDate = (s) => new Date(s).toLocaleDateString('vi-VN', { year: 'numeric', month: 'short', day: 'numeric' });
const toCard = (e, base) => ({
  href: `${base}/${e.id}/`,
  cat: `${e.data.emoji} ${e.data.category}`,
  title: e.data.title,
  description: e.data.description,
  author: e.data.author,
  date: fmtDate(e.data.publishDate),
});

const site = 'https://fluttercook.github.io';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'FlutterCook',
    url: `${site}/vi/`,
    inLanguage: ['vi', 'en'],
    description: `${total} hướng dẫn thực hành về các thư viện, UI kit và ứng dụng Flutter mã nguồn mở tốt nhất.`,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'FlutterCook',
    url: `${site}/`,
    logo: `${site}/logo.png`,
    sameAs: ['https://github.com/fluttercook', 'https://flutter9.blogspot.com'],
  },
];
---
<BaseLayout lang="vi" title="FlutterCook — 510 công thức Flutter mã nguồn mở, ưu tiên AI" jsonLd={jsonLd}>
  <main class="wrap">
    <section class="hero">
      <div class="kicker">Mã nguồn mở · Ưu tiên AI · Theo xu hướng</div>
      <h1 class="serif">Sổ tay các thư viện <i>Flutter</i> tốt nhất.</h1>
      <p>{total} hướng dẫn thực hành về các dự án và thành phần Flutter mã nguồn mở hàng đầu — xếp hạng từ dữ liệu xu hướng GitHub trực tiếp, mỗi bài nêu rõ nó làm gì, vì sao đang lên, và cách dùng.</p>
      <div class="cta-row">
        <a class="btn pri" href="/vi/recipes/">Xem công thức</a>
        <a class="btn" href="/vi/trends/">Xu hướng GitHub trực tiếp</a>
      </div>
    </section>
    <section class="sec">
      <h2 class="serif">Đang <i>thịnh hành</i></h2>
      <p class="lead">Các dự án có đà tăng mạnh nhất trong dữ liệu, theo số sao có tính đến độ mới.</p>
      <div class="grid">
        {featured.map((r) => (
          <a class="card" href={`/vi/recipes/${r.id}/`}>
            <span class="cat">{r.data.category}</span>
            <h3>{r.data.package}</h3>
            <p>{r.data.description}</p>
            <div class="meta"><span>★ <b>{r.data.stars.toLocaleString()}</b></span><span>Cập nhật {r.data.lastUpdate}</span></div>
          </a>
        ))}
      </div>
    </section>
    <CardRail
      id="rail-blog"
      title="Bài mới trên"
      accent="blog"
      lead="Hướng dẫn dài, ưu tiên code — dựng widget, hiểu phần toán, rồi hoàn thiện."
      href="/vi/blog/"
      moreLabel="Xem tất cả bài"
      prevLabel="Xem các bài trước"
      nextLabel="Xem thêm bài"
      items={latestPosts.map((p) => toCard(p, '/vi/blog'))}
    />

    <CardRail
      id="rail-news"
      title="Tin mới từ"
      accent="toà soạn"
      lead="Chuyện Apple, Android và Flutter, đọc theo hướng nó đổi gì trong app của bạn."
      href="/vi/news/"
      moreLabel="Xem tất cả tin"
      prevLabel="Xem tin trước đó"
      nextLabel="Xem thêm tin"
      items={latestNews.map((n) => toCard(n, '/vi/news'))}
    />

    <section class="sec">
      <h2 class="serif">Theo <i>danh mục</i></h2>
      <p class="lead">{cats.length} danh mục trên {total} công thức.</p>
      <div class="filterbar">
        {cats.map((c) => <a class="btn" href={`/vi/recipes/?cat=${encodeURIComponent(c)}`}>{c}</a>)}
      </div>
    </section>
  </main>
</BaseLayout>
