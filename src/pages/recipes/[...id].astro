---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Toc from '../../components/Toc.astro';
import Summary from '../../components/Summary.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const recipes = await getCollection('recipes');
  return recipes.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const site = 'https://fluttercook.github.io';
const url = `${site}/recipes/${entry.id}/`;
const metaDesc = d.seoDescription || d.description;

const article = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: d.title,
  description: metaDesc,
  url,
  datePublished: d.datePublished || undefined,
  dateModified: d.dateModified || d.datePublished || undefined,
  author: { '@type': 'Organization', name: 'FlutterCook', url: site },
  publisher: {
    '@type': 'Organization',
    name: 'FlutterCook',
    url: site,
    logo: { '@type': 'ImageObject', url: `${site}/logo.png` },
  },
  mainEntityOfPage: url,
  about: d.category,
  keywords: (d.keywords || []).join(', '),
};
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'FlutterCook', item: `${site}/` },
    { '@type': 'ListItem', position: 2, name: 'Recipes', item: `${site}/recipes/` },
    { '@type': 'ListItem', position: 3, name: d.package, item: url },
  ],
};
const faqLd = d.faq && d.faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: d.faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
const jsonLd = [article, breadcrumb, faqLd].filter(Boolean);
---
<BaseLayout
  title={`${d.title} · FlutterCook`}
  description={metaDesc}
  keywords={d.keywords}
  ogType="article"
  {/* Generated from GitHub + pub.dev metadata, so this page is deliberately
      kept out of both ad serving and the search index. Google Publisher
      Policies forbid monetising pages built from someone else's content
      without added value, and "low value content" is the most common AdSense
      rejection for templated pages. `follow` still passes link equity to the
      repos and to our own hand-written pages. To put them back: delete these
      two props from both recipe routes (en + vi) and drop the `filter` in
      astro.config.mjs. */}
  ads={false}
  robots="noindex, follow"
  datePublished={d.datePublished}
  dateModified={d.dateModified}
  jsonLd={jsonLd}
>
  <main class="wrap wrap-article">
    <article class="article article-toc">
      <nav class="crumb" aria-label="Breadcrumb">
        <a href="/">FlutterCook</a> / <a href="/recipes/">recipes</a> / {d.package}
      </nav>
      <h1 class="serif">{d.title}</h1>
      <p class="sub">{d.description}</p>
      <div class="factbox">
        <div><small>Category</small><b>{d.category}</b></div>
        <div><small>Stars</small><b>★ {d.stars.toLocaleString()}</b></div>
        <div><small>Last update</small><b>{d.lastUpdate}</b></div>
        <div><small>Priority</small><b>{d.priority}</b></div>
      </div>
      <Summary items={d.summary} lang="en" />
      <Toc headings={headings} lang="en" />
      <div class="prose">
        <Content />
      </div>
      {d.related && d.related.length > 0 && (
        <aside class="related">
          <h2>Related Flutter {d.category} guides</h2>
          <ul>
            {d.related.map((r) => (
              <li><a href={`/recipes/${r.slug}/`}>{r.title}</a></li>
            ))}
          </ul>
        </aside>
      )}
      {d.topics && d.topics.length > 0 && (
        <div class="tags">{d.topics.map((t) => <a href={`/recipes/`}>#{t}</a>)}</div>
      )}
    </article>
  </main>
</BaseLayout>
