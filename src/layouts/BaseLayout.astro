---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {
  title,
  description = 'FlutterCook — 510 hands-on guides to the best open-source Flutter libraries, UI kits, and apps for mobile app development. Every recipe ships with real GitHub trend data, install steps, alternatives, and an FAQ.',
  keywords = [],
  ogType = 'website',
  // Social cards: PNG, not SVG — Facebook, LinkedIn, Slack and X all refuse to
  // render an SVG og:image and fall back to a bare link. Override `image`
  // together with imageWidth/imageHeight if a page ships its own card.
  image = '/og-default.png',
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = 'FlutterCook — 510 open-source Flutter recipes',
  datePublished,
  dateModified,
  jsonLd = [],
  lang = 'en',
  // Ads are served only on hand-written pages. The generated /recipes/ pages
  // pass ads={false}: Google Publisher Policies forbid monetising pages built
  // from someone else's content without added value, and those are templated
  // from GitHub metadata.
  ads = true,
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;
const ADSENSE_CLIENT = 'ca-pub-5091408807979195';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const kw = Array.isArray(keywords) ? keywords.join(', ') : keywords;
const graphs = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
// hreflang alternates: derive the shared canonical path (strip /vi) then build both.
const basePath = Astro.url.pathname.replace(/^\/vi(?=\/|$)/, '') || '/';
const enHref = new URL(basePath, Astro.site).href;
const viHref = new URL(basePath === '/' ? '/vi/' : `/vi${basePath}`, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="dark light" />
  <link rel="preconnect" href="https://www.googletagmanager.com" />
  <link rel="dns-prefetch" href="https://www.google-analytics.com" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {kw && <meta name="keywords" content={kw} />}
  <meta name="robots" content={robots} />
  <meta name="author" content="FlutterCook" />
  {/* Google Search Console, URL-prefix property for https://fluttercook.github.io/.
      A Domain property was started first but only DNS TXT can verify one, and we
      do not own github.io's zone — so this is the URL-prefix property's own
      HTML-tag token instead (a different string; tokens are per property and per
      method). Verification tokens are public by design. Do not remove it: Search
      Console re-checks periodically and unverifies the property if it vanishes. */}
  <meta name="google-site-verification" content="2ycDQu9CCJcyTnUgZKBB4cpkxzJhzrunqfj8AHcmYi8" />
  {/* Keeps AdSense site ownership verified even on pages that do not load the
      ad script (all of /recipes/, and 404). */}
  <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="en" href={enHref} />
  <link rel="alternate" hreflang="vi" href={viHref} />
  <link rel="alternate" hreflang="x-default" href={enHref} />
  <meta property="og:site_name" content="FlutterCook" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonical} />
  <meta property="og:locale" content={lang === 'vi' ? 'vi_VN' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'vi' ? 'en_US' : 'vi_VN'} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content={String(imageWidth)} />
  <meta property="og:image:height" content={String(imageHeight)} />
  <meta property="og:image:alt" content={imageAlt} />
  {datePublished && <meta property="article:published_time" content={datePublished} />}
  {dateModified && <meta property="article:modified_time" content={dateModified} />}
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8D%B3%3C/text%3E%3C/svg%3E" />
  {graphs.map((g) => (
    <script type="application/ld+json" set:html={JSON.stringify(g)} />
  ))}
  <!-- Google Analytics (gtag.js) — primary property + FighTechVN GA4 stream -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-B299VQ6G9N"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-B299VQ6G9N');
    gtag('config', 'G-25H7QLJYDE');
  </script>
  {ads && (
    <>
      <link rel="preconnect" href="https://pagead2.googlesyndication.com" />
      <script
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
        crossorigin="anonymous"
      ></script>
    </>
  )}
</head>
<body>
  <div class="wrap"><Header lang={lang} /></div>
  <slot />
  <Footer lang={lang} />
</body>
</html>
