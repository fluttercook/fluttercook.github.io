# Fallback for a box without systemd timers. Install with:
#   sudo crontab -u fluttercook deploy/crontab.example
#
# The lock is inside sync.sh's own single-run assumption, so flock keeps a slow
# run from overlapping the next tick.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

20 8  * * * flock -n /var/lib/fluttercook/sync.lock /opt/fluttercook/deploy/sync.sh >> /var/lib/fluttercook/logs/cron.log 2>&1
20 20 * * * flock -n /var/lib/fluttercook/sync.lock /opt/fluttercook/deploy/sync.sh >> /var/lib/fluttercook/logs/cron.log 2>&1

# Keep the log from growing without bound.
0 4 * * 0 find /var/lib/fluttercook/logs -name '*.log' -mtime +30 -delete
