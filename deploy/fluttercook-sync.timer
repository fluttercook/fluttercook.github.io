# Twice a day. With SYNC_LIMIT=3 that is up to 3 posts per blog/collection/lang
# per run — a steady drip rather than a burst, which is both what the content
# plan calls for and what keeps us clear of Blogger's daily post cap.
[Unit]
Description=FlutterCook Blogger sync schedule

[Timer]
OnCalendar=*-*-* 08:20:00
OnCalendar=*-*-* 20:20:00
# Spread the load if several machines ever share this unit, and catch up after
# the box has been off.
RandomizedDelaySec=10min
Persistent=true
Unit=fluttercook-sync.service

[Install]
WantedBy=timers.target
