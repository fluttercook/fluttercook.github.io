# Copy to /etc/fluttercook/sync.env (chmod 640, owned by root:fluttercook).
# Every value here is a default that sync.sh and admin_server.py already use —
# uncomment only what you want to change.

# Where the checkout lives, and where state that must survive a git reset goes.
APP_DIR=/opt/fluttercook
VAR_DIR=/var/lib/fluttercook
BRANCH=main

# Posts published per blog x collection x language, per run. Two runs a day at
# 3 means at most 36 posts a day across the three blogs -- under Blogger's cap,
# and steady enough to look like a publishing schedule rather than a dump.
SYNC_LIMIT=3

# Seconds between posts. Blogger throttles fast bursts; the publisher backs off
# on its own, but starting slower means it rarely has to.
SYNC_SLEEP=6

# Narrow any of these to skip work. Recipes are deliberately absent: at 1,000
# pages they are a multi-day job and would drown the report.
SYNC_BLOGS="trunghieu-it fluttercook flutter9"
SYNC_COLLECTIONS="blog news"
SYNC_LANGS="en vi"

# Admin dashboard. Leave ADMIN_TOKEN unset to use $VAR_DIR/admin_token, which
# the server mints on first start.
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8787
#ADMIN_TOKEN=
